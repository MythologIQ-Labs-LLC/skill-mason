 default: vv
 
 # The whole gate.
-vv: fmt-check model template-check lint test deny app
+vv: fmt-check model template-check lint test deny app eligibility
     @echo "vv: the acceptance gate passed"
 
 fmt-check:
@@ -76,6 +76,14 @@ app:
     rm -f .prism-proof.log
     cargo run -q --locked -p xtask -- proof-keep "$attestation"
 
+# Skill Mason's eligibility decision (`SM-01`). The model must be canonical and
+# locked, then `prismpm verify` builds its holo, replays its acceptance vectors
+# and has Lean and leanchecker check `eligible_decides`. It always proves in
+# full: no kept proof is reused for this project.
+eligibility:
+    (cd eligibility && lexlean fmt --check && lexlean lock --check)
+    prismpm --project eligibility verify
+
 # Only the meta-gate, while iterating on a scenario. `test` already runs it.
 bdd:
     cargo test --locked -p repo-conformance
